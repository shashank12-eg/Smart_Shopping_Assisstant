# ==============================================================================
# SmartShopping Environment Configuration
# ==============================================================================

# --- 1. MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smartshopping

# --- 2. Application Security ---
SECRET_KEY=smartshopping-secret-key-cse-2026

# --- 3. Retailer Data Provider API Keys ---
# Amazon: Get from RapidAPI (Real-Time Amazon Data API: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data)
# or Amazon Product Advertising API (PA-API)
AMAZON_API_KEY=

# Flipkart: Get from Flipkart Affiliate Program (https://affiliate.flipkart.com) or RapidAPI Flipkart API
FLIPKART_API_KEY=

# Meesho: Get from Meesho Partner/Developer Feed API
MEESHO_API_KEY=

# Myntra: Get from Myntra Partner/Developer Affiliate API
MYNTRA_API_KEY=

# Universal Shopping Search: RapidAPI Shopping & Price Tracker (https://rapidapi.com)
RAPIDAPI_SHOPPING_KEY=

# SerpApi: Real-time Google Shopping & Retailer Product Search (https://serpapi.com/google-shopping-api)
SERPAPI_KEY=

# --- 4. AI Intelligence Model Keys ---
# Google Gemini AI: For intelligent deal reasoning & spec synthesis (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI: Alternative model for intelligent analysis (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
