# ==============================================================================
# SmartShopping Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# --- 1. MySQL Database Configuration ---
# In Docker Compose, DB_HOST must be the service name 'db'. For local host dev, use 'localhost'.
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=smartshopping

# --- 2. Application Security ---
# Secret key used for signing JSON Web Tokens (JWT) and session cookies
SECRET_KEY=your_super_secret_jwt_key_here

# --- 3. Container Published Ports ---
# Frontend published port on host (access in browser via http://localhost:3080)
FRONTEND_PORT=3080
# Backend published port on host (access API via http://localhost:5000/api/health)
BACKEND_PORT=5000

# --- 4. External Retailer Data Providers (Optional) ---
AMAZON_API_KEY=
FLIPKART_API_KEY=
MEESHO_API_KEY=
MYNTRA_API_KEY=
RAPIDAPI_SHOPPING_KEY=
SERPAPI_KEY=

# --- 5. Optional AI Model Providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
